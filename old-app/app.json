{
  "expo": {
    "name": "RN Star Bank",
    "slug": "CC-RN-Banking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.camelcase.rnstarbank",
      "buildNumber": "1.0.0",
      "supportsTablet": false,
      "config": {
        "googleMapsApiKey": "ENTER_YOUR_GOOGLE_MAP_API_KEY_HERE"
      }
    },
    "android": {
      "package": "com.camelcase.rnstarbank",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "config": {
        "googleMaps": {
          "apiKey": "ENTER_YOUR_GOOGLE_MAP_API_KEY_HERE"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#9A415C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
